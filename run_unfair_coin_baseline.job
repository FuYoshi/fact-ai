#!/bin/bash
#SBATCH --job-name=IPPO_UnfairCoin
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --time=04:00:00
#SBATCH --output=slurm_unfair_coin_seed%a_%j.out
#SBATCH --array=0-3

# =============================================================================
# IPPO Baseline on UNFAIR Coin Game - Full Experiment (4 seeds)
# Paper-faithful setup: 15/16 green, 1/16 red coins
# =============================================================================

# Map array index to seed
SEEDS=(42 52 62 72)
SEED=${SEEDS[$SLURM_ARRAY_TASK_ID]}

echo "=== IPPO Baseline - Unfair Coin Game ==="
echo "Seed: $SEED (array task $SLURM_ARRAY_TASK_ID)"
echo "Job ID: $SLURM_JOB_ID"
echo ""

# Load modules
module purge
module load 2024
module load CUDA/12.6.0
module load cuDNN/9.5.0.50-CUDA-12.6.0
module load Python/3.12.3-GCCcore-13.3.0

source ~/.venvs/fcgrad/bin/activate
export XLA_FLAGS="--xla_gpu_cuda_data_dir=$CUDA_HOME"

cd $HOME/simon/fact_fcgrad

echo "=== Environment ==="
python -c "import jax; print(f'JAX {jax.__version__}, Backend: {jax.default_backend()}')"

echo ""
echo "=== Running IPPO on Unfair Coin (seed=$SEED) ==="
echo "Config: ippo_unfair_coin"
echo "  - 256 envs × 1000 steps"
echo "  - 1e9 total timesteps (~3900 updates)"
echo "  - green_coin_prob = 0.9375 (15/16)"
echo ""

python main.py --env coins --config ippo_unfair_coin --seed $SEED

echo ""
echo "=== Done (seed=$SEED) ==="
