#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=IPPO_Ind_s62
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=10:00:00
#SBATCH --output=slurm_ippo_ind_seed62_%j.out
#SBATCH --error=slurm_ippo_ind_seed62_%j.err

# ==============================================================================
# IPPO Individual Baseline - Seed 62
# ==============================================================================

echo "=============================================="
echo "  Job: IPPO Individual Baseline"
echo "  Seed: 62"
echo "  Config: ippo_unfair_coin (1B steps)"
echo "  Start: $(date)"
echo "=============================================="

# Load modules
module purge
module load 2024
module load CUDA/12.6.0
module load cuDNN/9.5.0.50-CUDA-12.6.0
module load Python/3.12.3-GCCcore-13.3.0

# Activate virtual environment
source ~/.venvs/fcgrad/bin/activate

# Set JAX flags
export XLA_FLAGS="--xla_gpu_cuda_data_dir=$CUDA_HOME"

# Navigate to project
cd $HOME/simon/fact_fcgrad

# Check GPU
echo ""
echo "GPU Info:"
nvidia-smi --query-gpu=name,memory.total --format=csv
echo ""

# Run training with seed 62
python main.py --config ippo_unfair_coin --seed 62

echo ""
echo "=============================================="
echo "  Job Complete: $(date)"
echo "=============================================="
