#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=test_fcgrad
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=00:30:00
#SBATCH --output=slurm_test_fcgrad_%j.out
#SBATCH --error=slurm_test_fcgrad_%j.err

# ==============================================================================
# Quick FCGrad Test - Minimal timesteps to verify implementation
# ==============================================================================

echo "=============================================="
echo "  Job: FCGrad Quick Test"
echo "  Config: test_fcgrad (100k steps)"
echo "  Start: $(date)"
echo "=============================================="

# Load modules
module purge
module load 2024
module load CUDA/12.6.0
module load cuDNN/9.5.0.50-CUDA-12.6.0
module load Python/3.12.3-GCCcore-13.3.0

# Activate virtual environment
source ~/.venvs/fcgrad/bin/activate

# Set JAX flags
export XLA_FLAGS="--xla_gpu_cuda_data_dir=$CUDA_HOME"

# Navigate to project
cd $HOME/simon/fact_fcgrad

# Check GPU
echo ""
echo "GPU Info:"
nvidia-smi --query-gpu=name,memory.total --format=csv
echo ""

# Run quick test
echo "Running FCGrad test..."
python main.py --config test_fcgrad

echo ""
echo "=============================================="
echo "  Job Complete: $(date)"
echo "=============================================="
