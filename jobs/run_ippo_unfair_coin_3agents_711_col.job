#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:h100:1
#SBATCH --job-name=IPPO_3A_Col
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=20:00:00
#SBATCH --output=slurm_%x_%j.out

# =============================================================================
# IPPO Baseline - 3 Agents with 7:1:1 distribution - Collective Rewards
# Unfair Coin Game (77.78% agent 0, 11.11% each agents 1 and 2)
# =============================================================================

echo "=============================================="
echo "  IPPO Unfair Coin Game - 3 Agents (7:1:1)"
echo "  Reward type: Collective"
echo "=============================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $SLURMD_NODENAME"
echo ""

# Load modules
module purge
module load 2024
module load CUDA/12.6.0
module load cuDNN/9.5.0.50-CUDA-12.6.0
module load Python/3.12.3-GCCcore-13.3.0

# Activate virtual environment
source ~/.venvs/fcgrad/bin/activate

# Set XLA flags for JAX GPU
export XLA_FLAGS="--xla_gpu_cuda_data_dir=$CUDA_HOME"

# Verify setup
echo "Verifying JAX GPU setup..."
python -c "import jax; print(f'JAX {jax.__version__}, Backend: {jax.default_backend()}, Devices: {jax.devices()}')"

# Navigate to project directory
cd $HOME/fact-ai

echo ""
echo "Running: ippo_unfair_coin_3agents_711_col"
echo ""

# Run training
python main.py --config ippo_unfair_coin_3agents_711_col

echo ""
echo "Training complete"
