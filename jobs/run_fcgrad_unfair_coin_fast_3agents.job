#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=FCGrad_Unfair_Coin_3Agents
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=10:00:00
#SBATCH --output=slurm_fcgrad_unfair_coin_fast_3agents_%j.out

# =============================================================================
# FCGrad Unfair Coin Game - Fast Config with 3 Agents
# =============================================================================

echo "=============================================="
echo "  FCGrad Unfair Coin Game - Fast Training (3 Agents)"
echo "=============================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $SLURMD_NODENAME"
echo "Time limit: 10 hours"
echo ""

# Load modules
echo "Loading modules..."
module purge
module load 2024
module load CUDA/12.6.0
module load cuDNN/9.5.0.50-CUDA-12.6.0
module load Python/3.12.3-GCCcore-13.3.0

# Activate virtual environment
echo "Activating virtual environment..."
source ~/.venvs/fcgrad/bin/activate

# Set XLA flags for JAX GPU
export XLA_FLAGS="--xla_gpu_cuda_data_dir=$CUDA_HOME"

# Verify setup
echo ""
echo "🔍 Verifying JAX GPU setup..."
python -c "import jax; print(f'   JAX {jax.__version__}, Backend: {jax.default_backend()}, Devices: {jax.devices()}')"

# Navigate to IPPO directory
cd ~/simon/fact_fcgrad/external/SocialJax/algorithms/IPPO

echo ""
echo "=============================================="
echo "  Running: fcgrad_unfair_coin_fast"
echo "  Config: Fast testing config"
echo "  Agents: 3"
echo "=============================================="
echo ""

# Run training
python ippo_cnn_coins.py --config-name=fcgrad_unfair_coin_fast

echo ""
echo "Training complete"
echo "Check wandb project: ippo-unfair-coin-test"
echo "Models saved to: checkpoints/"
