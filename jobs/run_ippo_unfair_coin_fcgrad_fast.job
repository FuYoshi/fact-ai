#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=IPPO_FCGrad_Fast
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=02:00:00          # 2 hours should be enough for fast test (50M timesteps)
#SBATCH --output=slurm_ippo_unfair_coin_fcgrad_fast_%j.out

# =============================================================================
# Fast Test Job - FCGrad on Unfair Coin Game
# Reduced parameters for faster training:
# - 50M timesteps (instead of 1B)
# - Smaller grid size (12x8)
# - Fewer environments and steps
# =============================================================================

echo "=============================================="
echo "  FCGrad Fast Test - Unfair Coin Game"
echo "=============================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $SLURMD_NODENAME"
echo "Time limit: 2 hours"
echo ""

# Load modules
echo "📦 Loading modules..."
module purge
module load 2024
module load CUDA/12.6.0
module load cuDNN/9.5.0.50-CUDA-12.6.0
module load Python/3.12.3-GCCcore-13.3.0

# Activate virtual environment
echo "🐍 Activating virtual environment..."
source ~/.venvs/fcgrad/bin/activate

# Set XLA flags for JAX GPU
export XLA_FLAGS="--xla_gpu_cuda_data_dir=$CUDA_HOME"

# Verify setup
echo ""
echo "🔍 Verifying JAX GPU setup..."
python -c "import jax; print(f'   JAX {jax.__version__}, Backend: {jax.default_backend()}, Devices: {jax.devices()}')"

# Navigate to IPPO directory
cd ~/simon/fact_fcgrad/external/SocialJax/algorithms/IPPO

echo ""
echo "=============================================="
echo "  Running: fcgrad_unfair_coin_fast"
echo "  Config: Fast test (50M timesteps)"
echo "  Environment: Unfair Coin Game (green_coin_prob=0.9375)"
echo "  Method: FCGrad with dual value heads"
echo "=============================================="
echo ""

# Run training with fast config
python ippo_cnn_coins.py --config-name=fcgrad_unfair_coin_fast

echo ""
echo "✅ Training complete!"
echo "Check wandb project: fcgrad-unfair-coin-test"
echo "Models saved to: checkpoints/indvidual/"
