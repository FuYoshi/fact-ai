#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=ippo_col_fast
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=02:00:00
#SBATCH --output=slurm_ippo_col_fast_%j.out
#SBATCH --error=slurm_ippo_col_fast_%j.err

# ==============================================================================
# IPPO Collective Baseline - Fast Testing Config
# ==============================================================================
# Fast config for quick comparison: 50M timesteps, reduced parameters
# Collective rewards baseline (shared_rewards: True)
# Compare with ippo_unfair_coin_ind_fast for fairness metrics
# ==============================================================================

echo "=============================================="
echo "  Job: IPPO Collective Baseline (Fast)"
echo "  Config: ippo_unfair_coin_col_fast (50M steps)"
echo "  Start: $(date)"
echo "=============================================="

# Load modules
module purge
module load 2024
module load CUDA/12.6.0
module load cuDNN/9.5.0.50-CUDA-12.6.0
module load Python/3.12.3-GCCcore-13.3.0

# Activate virtual environment
source ~/.venvs/fcgrad/bin/activate

# Set JAX flags
export XLA_FLAGS="--xla_gpu_cuda_data_dir=$CUDA_HOME"

# Navigate to project
cd $HOME/simon/fact_fcgrad

# Check GPU
echo ""
echo "GPU Info:"
nvidia-smi --query-gpu=name,memory.total --format=csv
echo ""

# Run training
echo "Running IPPO Collective Baseline (Fast)..."
python main.py --config ippo_unfair_coin_col_fast

echo ""
echo "=============================================="
echo "  Job Complete: $(date)"
echo "=============================================="
