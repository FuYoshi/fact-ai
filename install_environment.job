#!/bin/bash

#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=InstallWorking
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=02:00:00
#SBATCH --output=slurm_install_working_%A.out

# =============================================================================
# WORKING SETUP: CUDA 12.6 + cuDNN 9.5 + JAX 0.4.30 cuda12_local
# =============================================================================

echo "=== Loading modules ==="
module purge
module load 2024
module load CUDA/12.6.0
module load cuDNN/9.5.0.50-CUDA-12.6.0
module load Python/3.12.3-GCCcore-13.3.0

cd $HOME/simon/fact_fcgrad/

echo "CUDA_HOME: $CUDA_HOME"
nvcc --version

# Create persistent venv
echo ""
echo "=== Creating virtual environment ==="
rm -rf $HOME/.venvs/fcgrad
python -m venv $HOME/.venvs/fcgrad
source $HOME/.venvs/fcgrad/bin/activate
pip install --upgrade pip --quiet

# =============================================================================
# Install JAX with CUDA (the working way!)
# =============================================================================
echo ""
echo "=== Installing JAX 0.4.30 with cuda12_local ==="
pip install "jax[cuda12_local]==0.4.30"

# Verify GPU works
echo ""
echo "=== Verifying JAX GPU ==="
python -c "import jax; print(f'JAX: {jax.__version__}, Devices: {jax.devices()}, Backend: {jax.default_backend()}')"

# =============================================================================
# Install other dependencies (compatible with JAX 0.4.30)
# =============================================================================
echo ""
echo "=== Installing dependencies ==="

# Flax 0.8.5 is compatible with JAX 0.4.30 (use --no-deps to prevent JAX upgrade)
pip install flax==0.8.5 --no-deps
pip install chex==0.1.84
pip install optax==0.1.7
pip install distrax==0.1.5

# Pin numpy to avoid conflicts
pip install numpy==1.26.4

# Hydra and config
pip install hydra-core==1.3.2
pip install omegaconf>=2.3.0

# Environments
pip install gymnax==0.0.8
pip install gymnasium==1.0.0
pip install dm-env==1.6
pip install dm-tree==0.1.8

# Logging
pip install wandb==0.18.5

# JaxMarl (this may upgrade JAX, we'll fix it after)
pip install jaxmarl==0.0.7

# =============================================================================
# IMPORTANT: Reinstall JAX 0.4.30 with cuda12_local 
# (jaxmarl upgrades JAX, breaking the CUDA plugin)
# =============================================================================
echo ""
echo "=== Reinstalling JAX 0.4.30 with CUDA (fixing jaxmarl upgrade) ==="
pip uninstall -y jax jaxlib jax-cuda12-plugin jax-cuda12-pjrt 2>/dev/null || true
pip install "jax[cuda12_local]==0.4.30"

# =============================================================================
# Final verification
# =============================================================================
echo ""
echo "=========================================="
echo "FINAL VERIFICATION"
echo "=========================================="
python << 'EOF'
import jax
print(f"JAX version: {jax.__version__}")
print(f"Devices: {jax.devices()}")
print(f"Backend: {jax.default_backend()}")

# Test GPU computation
import jax.numpy as jnp
x = jnp.ones((1000, 1000))
y = jnp.dot(x, x)
print(f"GPU compute test: OK (result on {y.devices()})")

import flax
print(f"Flax version: {flax.__version__}")

import hydra
print("Hydra: OK")

import jaxmarl
print("JaxMarl: OK")

print("\n✓ ALL CHECKS PASSED!")
EOF

echo ""
echo "=========================================="
echo "TO USE THIS ENVIRONMENT:"
echo "  module purge"
echo "  module load 2024"
echo "  module load CUDA/12.6.0"
echo "  module load cuDNN/9.5.0.50-CUDA-12.6.0"
echo "  module load Python/3.12.3-GCCcore-13.3.0"
echo "  source ~/.venvs/fcgrad/bin/activate"
echo "=========================================="
echo ""
echo "Installation complete!"
